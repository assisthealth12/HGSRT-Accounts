rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // Manager has full operational access, same as Admin — the only asymmetry is the
    // Audit Log (Admin-only read) and who can grant a new login (Admin-only, enforced
    // in the createStaffLogin Cloud Function).
    function isManager() {
      return isAuthenticated() && (getUserRole() == 'manager' || isAdmin());
    }

    function isFromProperty(propertyId) {
      return resource.data.propertyId == propertyId &&
             request.auth.token.propertyId == propertyId;
    }

    function isCreatingForProperty(propertyId) {
      return request.resource.data.propertyId == propertyId &&
             request.auth.token.propertyId == propertyId;
    }

    // --- FOUNDATION / LOOKUP TABLES ---
    match /roomTypes/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create, update: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      allow delete: if isAdmin() && isFromProperty(resource.data.propertyId);
    }

    match /paymentModes/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create, update: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      allow delete: if isAdmin() && isFromProperty(resource.data.propertyId);
    }

    match /expenseCategories/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create, update: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      allow delete: if isAdmin() && isFromProperty(resource.data.propertyId);
    }

    match /rooms/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create, update: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      allow delete: if isAdmin() && isFromProperty(resource.data.propertyId);
    }

    // --- ROOMS & GUEST REGISTER ---
    match /bookings/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create, update: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      // Bookings are never physically deleted — a guest's history stays intact.
      allow delete: if false;
    }

    match /banquetBookings/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create, update: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      allow delete: if isAdmin();
    }

    match /payments/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      // Payments are append-only — correcting an amount means adding another row.
      allow update, delete: if false;
    }

    // --- RESTAURANT & BANQUET DAILY SALES ---
    match /restaurantDailySales/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create, update: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      allow delete: if isAdmin() && isFromProperty(resource.data.propertyId);
    }

    match /banquetSales/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create, update: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      allow delete: if isAdmin() && isFromProperty(resource.data.propertyId);
    }

    // --- STAFF, ATTENDANCE, PAYROLL ---
    match /staff/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create, update: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      allow delete: if isAdmin() && isFromProperty(resource.data.propertyId);
    }

    match /attendance/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create, update: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      allow delete: if false; // corrected, never deleted
    }

    match /payrollPayments/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      allow update, delete: if false; // append-only, same discipline as payments
    }

    // --- EXPENSES ---
    match /expenses/{id} {
      allow read: if isManager() && isFromProperty(resource.data.propertyId);
      allow create: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      allow update, delete: if false;
    }

    // --- AUDIT LOG ---
    // Written by clients after every edit/delete, read-only for Admins, immutable once written.
    match /auditLogs/{id} {
      allow read: if isAdmin() && isFromProperty(resource.data.propertyId);
      allow create: if isManager() && isCreatingForProperty(request.resource.data.propertyId);
      allow update, delete: if false;
    }

    // Fallback: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
